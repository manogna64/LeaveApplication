<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Casual_Leave_Limit</fullName>
    <active>true</active>
    <errorConditionFormula>IF (
  Duration__c &gt; 3,
  (ISPICKVAL (Leave_Type__c, &quot;Casual Leave&quot;)),
  false
)</errorConditionFormula>
    <errorDisplayField>Leave_Type__c</errorDisplayField>
    <errorMessage>Casual Leave must not exceed 3 days</errorMessage>
</ValidationRule>
